# ============================================================
#  Configuración Apache — funciona en XAMPP y en el servidor
# ============================================================
Options -Indexes
DirectoryIndex index.php

# Página de error personalizada (ajusta la ruta si el sitio vive en una subcarpeta)
# Local XAMPP en /congreso/:  ErrorDocument 404 /congreso/404.php
# Servidor en la raíz:        ErrorDocument 404 /404.php
ErrorDocument 404 /congreso/404.php

# Bloquear acceso directo a carpetas internas
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(includes|data|storage|docs)(/|$) - [F,L]
</IfModule>

# Bloquear archivos sensibles
<FilesMatch "\.(json|csv|md|gs|log|ini)$">
  Require all denied
</FilesMatch>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Caché de recursos estáticos (los archivos llevan ?v= automático)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
